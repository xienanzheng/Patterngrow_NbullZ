{
  "version": 2,
  "crons": [
    {
      "path": "/api/alerts/run",
      "schedule": "30 20 * * 1-5"
    },
    {
      "path": "/api/alerts/daily-summary",
      "schedule": "0 21 * * 1-5"
    }
  ],
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
