# Public historical research works without credentials. No secrets belong in Git.
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Historical price source: yahoo (default) or twelvedata.
MARKET_DATA_PROVIDER=yahoo
TWELVE_DATA_API_KEY=

# Optional supplemental data. Keys are server-side only.
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=

# Account features are unavailable until Supabase is configured.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Only these verified user IDs, or users with trusted app_metadata.role=admin,
# can update shared ticker metadata. Empty means no IDs are authorized here.
METADATA_ADMIN_USER_IDS=

# Optional research summaries.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Existing scheduled jobs require this secret.
CRON_SECRET=
